<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state (Bold Royal Blue) -->
    <item android:color="#1D4ED8" android:state_checked="true" />

    <!-- Pressed state -->
    <item android:color="#1D4ED8" android:state_pressed="true" />

    <!-- Default / Unselected state (Visible Slate Gray, NOT transparent!) -->
    <item android:color="#64748B" />
</selector>