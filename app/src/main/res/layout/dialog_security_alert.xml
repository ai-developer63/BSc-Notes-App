<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="#D32F2F"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/imgSecurityIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_lock"
            app:tint="#D32F2F"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSecurityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Security Alert"
            android:textColor="#D32F2F"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSecurityMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unusual activity detected."
            android:textAlignment="center"
            android:textColor="#424242"
            android:textSize="15sp"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecurityAcknowledge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I UNDERSTAND"
            app:backgroundTint="#D32F2F"
            app:cornerRadius="8dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>