<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeColor="#FF3B30"
    app:strokeWidth="2dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="#FF3B30" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:gravity="center">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_block_security"
                app:tint="#FF3B30"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HARDWARE BLACKLISTED"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Critical security violation detected. This device is permanently restricted from GyanKosh services due to unethical activity. While doing Appeal Please take ScreenShot of this Screen."
                android:textAlignment="center"
                android:textSize="15sp"
                android:textColor="#4A4A4A"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvDeviceID"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE ID: 8A72-FD01-XXXX"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#666666"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS: PERMANENT_RESTRICTION"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FF3B30"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppeal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="APPEAL RESTRICTION"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:backgroundTint="#1A1A1A"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExit"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TERMINATE SESSION"
                android:textColor="#FF3B30"
                android:letterSpacing="0.05"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>